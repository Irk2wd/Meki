[Unit]
Description=Private mekiR preview WebDAV
After=network.target

[Service]
User=mekir-preview
Group=mekir-preview
EnvironmentFile=/etc/mekir-preview/endpoint
RuntimeDirectory=mekir-preview
ExecStart=/usr/sbin/apache2 -DFOREGROUND -f /etc/mekir-preview/httpd.conf
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/mekir-previews
UMask=0077

[Install]
WantedBy=multi-user.target
